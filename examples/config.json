    "allow_localhost": true,
    "allow_private_networks": false
  },
  "activity": { "retention_days": 30 },
  "notify": { "desktop": true, "popup": true },
  "voice": { "provider": "kokoro", "voice": "af_heart", "speed": 1 }
}
